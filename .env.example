# ════════════════════════════════════════════════════════════
# Möbel İnegöl — Environment Variables
# .env.local olarak kopyala, değerleri doldur
# Vercel Dashboard > Settings > Environment Variables'a da ekle
# ════════════════════════════════════════════════════════════

# ─── Supabase (Supabase Dashboard > Settings > API) ────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# ─── Admin Yetkisi ─────────────────────────────────────────
# JavaScript (middleware/API) tarafı admin listesi.
# ⚠️ Postgres'teki app.admin_emails ayarıyla BİREBİR AYNI olmalı
#    (bkz. sql/00-ADMIN-EMAILS-SETUP.sql). İkisi de set edilmeli.
ADMIN_EMAILS=mobelinegol16@gmail.com

# ─── Rate Limit (Upstash Redis) — PRODUCTION'DA ŞART ───────
# Set edilmezse rate-limit Vercel'de instance başına izole çalışır
# (etkisiz). Brute-force/spam koruması için MUTLAKA bağla.
# Upstash Dashboard > Redis > REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxx...

# ─── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mobelinegol.com

# ─── İşletme Bilgileri ─────────────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=Möbel İnegöl
NEXT_PUBLIC_BUSINESS_TAGLINE=Evinize Değer Katar
NEXT_PUBLIC_BUSINESS_EMAIL=mobelinegol16@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=05360400118
NEXT_PUBLIC_BUSINESS_ADDRESS=Wobilimo AVM, 2. Kat No.122, İnegöl / Bursa
NEXT_PUBLIC_BUSINESS_ADDRESS_FULL=Wobilimo AVM, 2. Kat No.122, İnegöl / Bursa

# ─── WhatsApp & Sosyal Medya ────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=905360400118
NEXT_PUBLIC_INSTAGRAM_HANDLE=mobelinegol
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/102441879046107/

# ─── Google Maps (Mağaza Konumu) ───────────────────────────
# Yeniceköy Mh. Mobilya Cd. No 32, İnegöl / Bursa
# Kaynak link: https://maps.app.goo.gl/NEF3Afbmk8NQApkk9
NEXT_PUBLIC_MAP_LAT=40.07660
NEXT_PUBLIC_MAP_LNG=29.51540
NEXT_PUBLIC_MAP_QUERY=Möbel İnegöl+Mobilya+İnegöl

# ─── Analytics (Opsiyonel) ─────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Güvenlik ──────────────────────────────────────────────
CRON_SECRET=buraya-guclu-rastgele-sifre-yaz
IP_SALT=buraya-baska-guclu-sifre-yaz

# ─── Ubivo Lisans (opsiyonel — set edilmezse lisans kontrolü kapalı/aktif) ──
UBIVO_SUPABASE_URL=
UBIVO_SUPABASE_ANON_KEY=
UBIVO_LICENSE_ID=
UBIVO_DOMAIN=mobelinegol.com

# ─── Sentry (Opsiyonel) ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Cloudflare R2 (görsel depolama) — v41 ───
# Beşi de doluysa yeni görseller R2'ye yüklenir; boşsa Supabase'e (fallback).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mobel-medya
NEXT_PUBLIC_R2_PUBLIC_URL=
